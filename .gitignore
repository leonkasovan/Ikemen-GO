external/script/version
external/gamecontrollerdb.txt
*.manifest
*.cmd
*.bat
*.sh
# Keep only our own build scripts (top-level build/), NOT scripts inside the
# downloaded dependency source trees (SDL/FFmpeg/libxmp), which would otherwise
# be re-included by a recursive !build/**/*.sh and make git recurse into them.
!build/*.sh
save/*

